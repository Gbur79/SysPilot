#!/usr/bin/env bash
# SysPilot thin router — engine-independent, cache-first, terminal & GUI native.
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

readonly USER_HOME="${HOME:?HOME is not set}"
readonly STATE_HOME="${XDG_STATE_HOME:-$USER_HOME/.local/state}"
readonly STATUS_FILE="$STATE_HOME/system-health/summary.json"
readonly CONFIG_FILE="${XDG_CONFIG_HOME:-$USER_HOME/.config}/syspilot/config.env"
SCRIPT_SOURCE=$(readlink -f -- "${BASH_SOURCE[0]}")
readonly SCRIPT_SOURCE
SCRIPT_DIR=$(cd -- "$(dirname -- "$SCRIPT_SOURCE")" && pwd)
readonly SCRIPT_DIR
PROJECT_ROOT=$(dirname -- "$SCRIPT_DIR")
readonly PROJECT_ROOT
readonly DEFAULT_DATA_ROOT="/usr/share/syspilot"
readonly VERSION="2.1.3"

# Source optional user config if present
if [[ -f "$CONFIG_FILE" && -r "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

readonly MAX_STATUS_AGE="${SYSPILOT_MAX_STATUS_AGE:-21600}"

err()  { printf 'syspilot: %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }
have() { command -v -- "$1" >/dev/null 2>&1; }

usage() {
    cat <<'EOF'
Usage: syspilot [OPTION]
  --gui                       Launch the SysPilot Desktop Dashboard
  -s, --status                Read and format cached sys-health summary
  -j, --json                  Print cached canonical sys-health JSON
  -a, --audit                 Explicit foreground audit
  -u, --upgrade               Explicit guarded upgrade
  --software                  Explicit software audit
  -o, --orphans               Explicit orphan review
  --mirrors                   Explicit mirror workflow
  -m, --maintenance           Explicit maintenance
  -d, --deep-clean            Explicit deep-clean workflow
  --check-update              Check upstream GitHub release for updates
  --self-update               Perform safe self-update and atomic build
  -g, --gaming                Explicit gaming readiness audit
  --copilot QUESTION          Start terminal-native Goose SRE session
  --copilot-shell             Open an interactive Goose SRE session
  --tray                      Start the StatusNotifierItem tray
  --faf-repair, --faf-setup   Setup or repair Forged Alliance Forever runner
  --enable-autostart          Enable packaged systemd user service
  --disable-autostart         Disable packaged systemd user service
  -v, --version               Print version information and exit
  -h, --help                  Show help

Environment / Configuration (~/.config/syspilot/config.env):
  SYSPILOT_SYS_HEALTH         Development/test engine override
  SYSPILOT_TERMINAL           Preferred supported terminal executable
  SYSPILOT_COPILOT_CMD        Custom copilot executable override
  SYSPILOT_GOOSE_RECIPE       Optional Goose recipe path override
  SYSPILOT_MAX_STATUS_AGE     Cache freshness limit in seconds (default 21600)
EOF
}

have_engine() {
    local candidate resolved
    if [[ -n ${SYSPILOT_SYS_HEALTH:-} ]]; then
        candidate=$SYSPILOT_SYS_HEALTH
    else
        candidate=$(command -v sys-health 2>/dev/null || true)
    fi
    [[ -n $candidate && -x $candidate ]] || return 1
    resolved=$(readlink -f -- "$candidate" 2>/dev/null) || return 1
    case $resolved in
        */sysPilot/bin/sys-health.sh|*/syspilot/bin/sys-health.sh)
            return 1 ;;
    esac
    return 0
}

resolve_engine() {
    local candidate resolved
    if [[ -n ${SYSPILOT_SYS_HEALTH:-} ]]; then
        candidate=$SYSPILOT_SYS_HEALTH
    else
        candidate=$(command -v sys-health 2>/dev/null || true)
    fi
    [[ -n $candidate && -x $candidate ]] || \
        die "sys-health is not installed; install the canonical engine package"
    resolved=$(readlink -f -- "$candidate") || die "cannot resolve sys-health"
    case $resolved in
        */sysPilot/bin/sys-health.sh|*/syspilot/bin/sys-health.sh)
            die "refusing embedded sys-health copy: $resolved" ;;
    esac
    printf '%s\n' "$resolved"
}

validate_status() {
    if [[ ! -f $STATUS_FILE || -L $STATUS_FILE || ! -r $STATUS_FILE ]]; then
        if ! have_engine; then
            die "no readable canonical summary; sys-health is not installed. Install sys-health or configure SYSPILOT_SYS_HEALTH to generate telemetry."
        fi
        die "no readable canonical summary; run: syspilot --audit"
    fi
    have jq || die "jq is required"
    jq -e '
      (.schema_version | tostring | startswith("2.")) and
      (.status | type == "string") and
      (.timestamp | type == "string")
    ' "$STATUS_FILE" >/dev/null 2>&1 || die "invalid or incompatible summary schema"
}

status_age() {
    local now mtime
    now=$(date +%s)
    mtime=$(stat -c %Y -- "$STATUS_FILE")
    printf '%s\n' "$((now - mtime))"
}

compact_health_context() {
    local now mtime age
    [[ -f $STATUS_FILE && ! -L $STATUS_FILE && -r $STATUS_FILE ]] || return 1
    have jq || return 1
    now=$(date +%s) || return 1
    mtime=$(stat -c %Y -- "$STATUS_FILE") || return 1
    (( mtime <= now )) || return 1
    age=$((now - mtime))
    jq -er --argjson age "$age" '
      select((.schema_version | tostring | startswith("2."))) |
      "schema=" + (.schema_version | tostring) +
      ";status=" + .status +
      ";observed=" + .timestamp +
      ";age_s=" + ($age | tostring) +
      ";errors=" + ((.counts.errors // 0) | floor | tostring) +
      ";warnings=" + ((.counts.warnings // 0) | floor | tostring)
    ' "$STATUS_FILE" 2>/dev/null
}

print_json() {
    validate_status
    cat -- "$STATUS_FILE"
    printf '\n'
    (( $(status_age) <= MAX_STATUS_AGE )) || return 3
}

print_status() {
    local age rc=0
    validate_status
    age=$(status_age)
    (( age <= MAX_STATUS_AGE )) || rc=3
    jq -r --argjson age "$age" --argjson limit "$MAX_STATUS_AGE" '
      "SysPilot — cached canonical health summary",
      "Status:       \(.status)",
      "Observed:     \(.timestamp)",
      "Cache age:    \($age)s" + (if $age > $limit then " (STALE)" else "" end),
      "Errors:       \(.counts.errors // 0)",
      "Warnings:     \(.counts.warnings // 0)",
      "Kernel:       \(.environment.kernel // "unknown")",
      "Game profile: " +
        (if .gaming.detected == true then "detected" else "not reported" end)
    ' "$STATUS_FILE"
    if (( rc == 3 )); then
        err "cached data is stale; an audit will run only when explicitly requested"
        return 3
    fi
    case $(jq -r '.status' "$STATUS_FILE") in
        ALL_CLEAR|FLIGHT_READY) return 0 ;;
        ACTION_REQUIRED)       return 1 ;;
        *)                     return 2 ;;
    esac
}

terminal_exec() {
    local requested=${SYSPILOT_TERMINAL:-} terminal="" name="" candidate
    if [[ -t 0 && -t 1 ]]; then
        exec "$@"
    fi
    if [[ -n $requested ]]; then
        [[ $requested != *[[:space:]]* ]] || \
            die "SYSPILOT_TERMINAL must be one executable, not shell syntax"
        [[ -x $requested ]] || have "$requested" || die "requested terminal not found"
        terminal=$requested
        name=$(basename -- "$requested")
    elif have xdg-terminal-exec; then
        exec xdg-terminal-exec -- "$@"
    else
        for candidate in konsole ghostty kitty alacritty gnome-terminal foot; do
            if have "$candidate"; then
                name=$candidate
                terminal=$(command -v -- "$candidate")
                break
            fi
        done
    fi
    case ${name:-} in
        konsole)        exec "${terminal:-konsole}" --nofork -e "$@" ;;
        ghostty)        exec "${terminal:-ghostty}" -e "$@" ;;
        kitty)          exec "${terminal:-kitty}" "$@" ;;
        alacritty)      exec "${terminal:-alacritty}" -e "$@" ;;
        gnome-terminal) exec "${terminal:-gnome-terminal}" -- "$@" ;;
        foot)           exec "${terminal:-foot}" "$@" ;;
        *) die "no supported terminal found; set SYSPILOT_TERMINAL" ;;
    esac
}

copilot() {
    local prompt="" caller_pwd="$PWD" recipe="" health=""
    local -a cmd
    printf -v prompt '%s ' "$@"
    prompt=${prompt% }
    [[ -n $prompt ]] || die "--copilot requires a question"

    if [[ -n ${SYSPILOT_COPILOT_CMD:-} ]]; then
        local -a custom_cmd
        # shellcheck disable=SC2294
        eval "custom_cmd=($SYSPILOT_COPILOT_CMD)"
        local is_agy=0 has_mode=0 arg
        if [[ ${custom_cmd[0]:-} =~ (^|/)agy$ ]] || [[ $SYSPILOT_COPILOT_CMD =~ (^|[[:space:]/])agy([[:space:]]|$) ]]; then
            is_agy=1
        fi
        for arg in "${custom_cmd[@]}"; do
            if [[ $arg == "-i" || $arg == "--prompt-interactive" || $arg == "-p" || $arg == "--print" || $arg == "--prompt" ]]; then
                has_mode=1
                break
            fi
        done
        if (( is_agy && !has_mode )); then
            custom_cmd+=(-i "$prompt")
        else
            custom_cmd+=("$prompt")
        fi
        terminal_exec "${custom_cmd[@]}"
        return
    fi

    if ! have goose; then
        if have agy; then
            terminal_exec agy -i "$prompt"
            return
        fi
        die "Neither Goose CLI nor agy CLI found. Configure SYSPILOT_COPILOT_CMD in ~/.config/syspilot/config.env"
    fi

    # Recipe Resolution:
    # 1. User config override: SYSPILOT_GOOSE_RECIPE
    # 2. Local project packaging: packaging/goose/recipes/copilot-admin.yaml
    # 3. System installed: /usr/share/syspilot/goose/recipes/copilot-admin.yaml
    if [[ -n ${SYSPILOT_GOOSE_RECIPE:-} && -f $SYSPILOT_GOOSE_RECIPE ]]; then
        recipe=$SYSPILOT_GOOSE_RECIPE
    elif [[ -f "$PROJECT_ROOT/packaging/goose/recipes/copilot-admin.yaml" ]]; then
        recipe="$PROJECT_ROOT/packaging/goose/recipes/copilot-admin.yaml"
    elif [[ -f "$DEFAULT_DATA_ROOT/goose/recipes/copilot-admin.yaml" ]]; then
        recipe="$DEFAULT_DATA_ROOT/goose/recipes/copilot-admin.yaml"
    fi

    health=$(compact_health_context || printf '%s' 'cache=unavailable')

    if [[ -n $recipe && -f $recipe ]]; then
        cmd=(env
             GOOSE_MODE=approve
             SECURITY_PROMPT_ENABLED=true
             GOOSE_DISABLE_SESSION_NAMING=true
             GOOSE_CLI_SHOW_COST=true
             goose run --recipe "$recipe"
             --params "user_query=$prompt"
             --params "health_context=$health"
             --params "working_directory=$caller_pwd"
             --interactive --name syspilot-sre --max-turns 15)
    else
        cmd=(env
             GOOSE_DISABLE_SESSION_NAMING=true
             GOOSE_CLI_SHOW_COST=true
             goose run --text
             "Cached health: $health. User request: $prompt"
             --interactive --name syspilot-sre --max-turns 15)
    fi
    terminal_exec "${cmd[@]}"
}

launch_gui() {
    # Prefer native Rust Slint GUI if compiled or installed
    if [[ -x "$PROJECT_ROOT/target/release/syspilot-gui" ]]; then
        nohup "$PROJECT_ROOT/target/release/syspilot-gui" >/dev/null 2>&1 &
        exit 0
    elif [[ -x "$PROJECT_ROOT/target/debug/syspilot-gui" ]]; then
        nohup "$PROJECT_ROOT/target/debug/syspilot-gui" >/dev/null 2>&1 &
        exit 0
    elif [[ -x "${XDG_BIN_HOME:-$HOME/.local/bin}/syspilot-gui" ]]; then
        nohup "${XDG_BIN_HOME:-$HOME/.local/bin}/syspilot-gui" >/dev/null 2>&1 &
        exit 0
    elif have syspilot-gui; then
        nohup syspilot-gui >/dev/null 2>&1 &
        exit 0
    else
        die "syspilot-gui is not installed or built"
    fi
}

launch_faf_repair() {
    local faf_bin=""
    if [[ -x "$PROJECT_ROOT/bin/syspilot-faf-repair" ]]; then
        faf_bin="$PROJECT_ROOT/bin/syspilot-faf-repair"
    elif [[ -x "/usr/lib/syspilot/bin/syspilot-faf-repair" ]]; then
        faf_bin="/usr/lib/syspilot/bin/syspilot-faf-repair"
    elif have syspilot-faf-repair; then
        faf_bin=$(command -v syspilot-faf-repair)
    else
        die "syspilot-faf-repair utility not found"
    fi
    exec "$faf_bin" "$@"
}

forward_engine() {
    local engine
    engine=$(resolve_engine)
    exec "$engine" "$@"
}

user_unit() {
    local verb=$1
    have systemctl || die "systemctl is required"
    systemctl --user cat syspilot-tray.service >/dev/null 2>&1 || \
        die "packaged syspilot-tray.service is not installed"
    exec systemctl --user "$verb" --now syspilot-tray.service
}

is_newer_version() {
    local curr=$1 up=$2
    curr=${curr#v}; curr=${curr#V}
    up=${up#v}; up=${up#V}

    local -a c_parts u_parts
    IFS='.-_' read -ra c_parts <<< "$curr"
    IFS='.-_' read -ra u_parts <<< "$up"

    local max_len=${#c_parts[@]}
    (( ${#u_parts[@]} > max_len )) && max_len=${#u_parts[@]}

    local i c u
    for (( i=0; i<max_len; i++ )); do
        c=${c_parts[i]:-0}
        u=${u_parts[i]:-0}
        (( u > c )) && return 0
        (( u < c )) && return 1
    done
    return 1
}

check_update() {
    printf 'Checking latest SysPilot release on GitHub...\n'
    local release_json=""
    if have curl; then
        release_json=$(curl -sS --fail --max-time 4 -H "User-Agent: SysPilot-Updater" "https://api.github.com/repos/Gbur79/SysPilot/releases/latest" 2>/dev/null || true)
    fi

    local upstream_tag=""
    if [[ -n "$release_json" ]] && have jq; then
        upstream_tag=$(echo "$release_json" | jq -r '.tag_name // empty' 2>/dev/null || true)
    fi

    if [[ -z "$upstream_tag" ]]; then
        local cache_file="$STATE_HOME/syspilot/github_release.json"
        if [[ -f "$cache_file" ]] && have jq; then
            upstream_tag=$(jq -r '.release.tag_name // empty' "$cache_file" 2>/dev/null || true)
        fi
    fi

    local upstream_clean="${upstream_tag#v}"

    if [[ -n "$upstream_clean" ]]; then
        printf 'Current version:  %s\n' "$VERSION"
        printf 'Upstream version: %s\n' "$upstream_tag"
        if is_newer_version "$VERSION" "$upstream_tag"; then
            printf '\n🚀 Update available! Run: syspilot --self-update\n'
        else
            printf '\n✔ SysPilot is up to date.\n'
        fi
    else
        printf 'Current version: %s (upstream release check unreachable or offline)\n' "$VERSION"
    fi
}

self_update() {
    printf '=== SysPilot Suite Self-Update & GitHub Sync ===\n'
    # 1. ALPM Dynamic Detection (pacman -Qo)
    if have pacman && pacman -Qo "$SCRIPT_SOURCE" >/dev/null 2>&1; then
        local pkg_owner
        pkg_owner=$(pacman -Qo "$SCRIPT_SOURCE" 2>/dev/null | awk '{print $NF}' || echo "syspilot")
        printf 'SysPilot is installed via Arch Linux package management (%s).\n' "$pkg_owner"
        printf 'Direct self-update is disabled to preserve ALPM database consistency.\n'
        printf 'Please update using your AUR helper or package manager:\n'
        printf '  yay -S %s  # or: paru -S %s\n' "$pkg_owner" "$pkg_owner"
        return 0
    fi

    # 2. Git Clone Detection
    if [[ -d "$PROJECT_ROOT/.git" ]]; then
        printf 'SysPilot Git repository detected at: %s\n' "$PROJECT_ROOT"
        cd "$PROJECT_ROOT"

        printf 'Checking Git working tree cleanliness...\n'
        if ! git diff-index --quiet HEAD -- 2>/dev/null; then
            die "Working tree has uncommitted or dirty modifications. Aborting self-update."
        fi

        printf 'Fetching upstream tags and updates...\n'
        git fetch --tags origin || die "Failed to fetch from git origin"

        printf 'Fast-forwarding to upstream branch...\n'
        git pull --ff-only origin main 2>/dev/null || git pull --ff-only origin master 2>/dev/null || git pull --ff-only || die "Fast-forward merge failed. Local branch has diverged."

        printf 'Rebuilding and installing SysPilot suite...\n'
        if [[ -x "$PROJECT_ROOT/dev-tools/build-and-install.sh" ]]; then
            "$PROJECT_ROOT/dev-tools/build-and-install.sh"
        elif [[ -x "$PROJECT_ROOT/build-and-install.sh" ]]; then
            "$PROJECT_ROOT/build-and-install.sh"
        else
            cargo build --release --locked -p syspilot-tray -p syspilot-gui
            local dest_bin="${XDG_BIN_HOME:-$HOME/.local/bin}"
            install -d -m 0755 "$dest_bin"
            install -m 0755 "$PROJECT_ROOT/target/release/syspilot-tray" "$dest_bin/syspilot-tray"
            install -m 0755 "$PROJECT_ROOT/target/release/syspilot-gui" "$dest_bin/syspilot-gui"
            install -m 0755 "$PROJECT_ROOT/bin/syspilot" "$dest_bin/syspilot"
        fi

        printf '\n✔ SysPilot suite successfully updated to latest version!\n'
        return 0
    fi

    # 3. Standalone binary fallback
    printf 'SysPilot standalone binary detected (no git repository found).\n'
    printf 'Visit https://github.com/Gbur79/SysPilot/releases to download the latest release.\n'
}

case ${1:-} in
    -h|--help)          usage ;;
    -v|--version)       printf 'syspilot %s\n' "$VERSION"; exit 0 ;;
    --gui)              launch_gui ;;
    -s|--status)        print_status ;;
    -j|--json)          print_json ;;
    -a|--audit)         shift; forward_engine --audit "$@" ;;
    -u|--upgrade)       shift; forward_engine --upgrade "$@" ;;
    --software)         shift; forward_engine --software "$@" ;;
    -o|--orphans)       shift; forward_engine --orphans "$@" ;;
    --mirrors)          shift; forward_engine --mirrors "$@" ;;
    -m|--maintenance)   shift; forward_engine --maintenance "$@" ;;
    -d|--deep-clean)    shift; forward_engine --deep-clean "$@" ;;
    --check-update)     check_update ;;
    --self-update)      self_update ;;
    -g|--gaming)        shift; forward_engine --gaming "$@" ;;
    --copilot)
        shift
        (($#)) || die "--copilot requires a question"
        copilot "$@"
        ;;
    --copilot-shell)
        copilot "Begin an interactive system SRE session. Do not run diagnostics until asked."
        ;;
    --faf-repair|--faf-setup)
        shift
        launch_faf_repair "$@"
        ;;
    --tray|"")
        if [[ -x "$PROJECT_ROOT/target/release/syspilot-tray" ]]; then
            exec "$PROJECT_ROOT/target/release/syspilot-tray"
        elif [[ -x "$PROJECT_ROOT/target/debug/syspilot-tray" ]]; then
            exec "$PROJECT_ROOT/target/debug/syspilot-tray"
        elif [[ -x "${XDG_BIN_HOME:-$HOME/.local/bin}/syspilot-tray" ]]; then
            exec "${XDG_BIN_HOME:-$HOME/.local/bin}/syspilot-tray"
        elif have syspilot-tray; then
            exec syspilot-tray
        else
            die "syspilot-tray is not installed or built"
        fi
        ;;
    --enable-autostart)  user_unit enable ;;
    --disable-autostart) user_unit disable ;;
    *) die "unknown option: $1 (use --help)" ;;
esac
