#!/usr/bin/env bash
# SysPilot thin router — engine-independent, cache-first, terminal & GUI native.
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

readonly USER_HOME="${HOME:?HOME is not set}"
readonly STATE_HOME="${XDG_STATE_HOME:-$USER_HOME/.local/state}"
readonly STATUS_FILE="$STATE_HOME/system-health/summary.json"
readonly CONFIG_FILE="${XDG_CONFIG_HOME:-$USER_HOME/.config}/syspilot/config.env"
readonly SCRIPT_SOURCE="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_SOURCE")" && pwd)"
readonly PROJECT_ROOT="$(dirname -- "$SCRIPT_DIR")"
readonly DEFAULT_DATA_ROOT="/usr/share/syspilot"

# Source optional user config if present
if [[ -f "$CONFIG_FILE" && -r "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

readonly MAX_STATUS_AGE="${SYSPILOT_MAX_STATUS_AGE:-21600}"

err()  { printf 'syspilot: %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }
have() { command -v -- "$1" >/dev/null 2>&1; }

usage() {
    cat <<'EOF'
Usage: syspilot [OPTION]
  --gui                       Launch the SysPilot Desktop Dashboard
  -s, --status                Read and format cached sys-health summary
  -j, --json                  Print cached canonical sys-health JSON
  -a, --audit                 Explicit foreground audit
  -u, --upgrade               Explicit guarded upgrade
  --software                  Explicit software audit
  -o, --orphans               Explicit orphan review
  --mirrors                   Explicit mirror workflow
  -m, --maintenance           Explicit maintenance
  -d, --deep-clean            Explicit deep-clean workflow
  -g, --gaming                Explicit gaming readiness audit
  --copilot QUESTION          Start terminal-native Goose SRE session
  --copilot-shell             Open an interactive Goose SRE session
  --tray                      Start the StatusNotifierItem tray
  --enable-autostart          Enable packaged systemd user service
  --disable-autostart         Disable packaged systemd user service
  -h, --help                  Show help

Environment / Configuration (~/.config/syspilot/config.env):
  SYSPILOT_SYS_HEALTH         Development/test engine override
  SYSPILOT_TERMINAL           Preferred supported terminal executable
  SYSPILOT_COPILOT_CMD        Custom copilot executable override
  SYSPILOT_GOOSE_RECIPE       Optional Goose recipe path override
  SYSPILOT_MAX_STATUS_AGE     Cache freshness limit in seconds (default 21600)
EOF
}

resolve_engine() {
    local candidate resolved
    if [[ -n ${SYSPILOT_SYS_HEALTH:-} ]]; then
        candidate=$SYSPILOT_SYS_HEALTH
    else
        candidate=$(command -v sys-health 2>/dev/null || true)
    fi
    [[ -n $candidate && -x $candidate ]] || \
        die "sys-health is not installed; install the canonical engine package"
    resolved=$(readlink -f -- "$candidate") || die "cannot resolve sys-health"
    case $resolved in
        */sysPilot/bin/sys-health.sh|*/syspilot/bin/sys-health.sh)
            die "refusing embedded sys-health copy: $resolved" ;;
    esac
    printf '%s\n' "$resolved"
}

validate_status() {
    [[ -f $STATUS_FILE && ! -L $STATUS_FILE && -r $STATUS_FILE ]] || \
        die "no readable canonical summary; run: syspilot --audit"
    have jq || die "jq is required"
    jq -e '
      (.schema_version | tostring | startswith("2.")) and
      (.status | type == "string") and
      (.timestamp | type == "string")
    ' "$STATUS_FILE" >/dev/null || die "invalid or incompatible summary schema"
}

status_age() {
    local now mtime
    now=$(date +%s)
    mtime=$(stat -c %Y -- "$STATUS_FILE")
    printf '%s\n' "$((now - mtime))"
}

compact_health_context() {
    local now mtime age
    [[ -f $STATUS_FILE && ! -L $STATUS_FILE && -r $STATUS_FILE ]] || return 1
    have jq || return 1
    now=$(date +%s) || return 1
    mtime=$(stat -c %Y -- "$STATUS_FILE") || return 1
    (( mtime <= now )) || return 1
    age=$((now - mtime))
    jq -er --argjson age "$age" '
      select((.schema_version | tostring | startswith("2."))) |
      "schema=" + (.schema_version | tostring) +
      ";status=" + .status +
      ";observed=" + .timestamp +
      ";age_s=" + ($age | tostring) +
      ";errors=" + ((.counts.errors // 0) | floor | tostring) +
      ";warnings=" + ((.counts.warnings // 0) | floor | tostring)
    ' "$STATUS_FILE" 2>/dev/null
}

print_json() {
    validate_status
    cat -- "$STATUS_FILE"
    printf '\n'
    (( $(status_age) <= MAX_STATUS_AGE )) || return 3
}

print_status() {
    local age rc=0
    validate_status
    age=$(status_age)
    (( age <= MAX_STATUS_AGE )) || rc=3
    jq -r --argjson age "$age" --argjson limit "$MAX_STATUS_AGE" '
      "SysPilot — cached canonical health summary",
      "Status:       \(.status)",
      "Observed:     \(.timestamp)",
      "Cache age:    \($age)s" + (if $age > $limit then " (STALE)" else "" end),
      "Errors:       \(.counts.errors // 0)",
      "Warnings:     \(.counts.warnings // 0)",
      "Kernel:       \(.environment.kernel // "unknown")",
      "Game profile: " +
        (if .gaming.detected == true then "detected" else "not reported" end)
    ' "$STATUS_FILE"
    if (( rc == 3 )); then
        err "cached data is stale; an audit will run only when explicitly requested"
        return 3
    fi
    case $(jq -r '.status' "$STATUS_FILE") in
        ALL_CLEAR|FLIGHT_READY) return 0 ;;
        ACTION_REQUIRED)       return 1 ;;
        *)                     return 2 ;;
    esac
}

terminal_exec() {
    local requested=${SYSPILOT_TERMINAL:-} terminal="" name="" candidate
    if [[ -t 0 && -t 1 ]]; then
        exec "$@"
    fi
    if [[ -n $requested ]]; then
        [[ $requested != *[[:space:]]* ]] || \
            die "SYSPILOT_TERMINAL must be one executable, not shell syntax"
        [[ -x $requested ]] || have "$requested" || die "requested terminal not found"
        terminal=$requested
        name=$(basename -- "$requested")
    elif have xdg-terminal-exec; then
        exec xdg-terminal-exec -- "$@"
    else
        for candidate in konsole ghostty kitty alacritty gnome-terminal foot; do
            if have "$candidate"; then
                name=$candidate
                terminal=$(command -v -- "$candidate")
                break
            fi
        done
    fi
    case ${name:-} in
        konsole)        exec "${terminal:-konsole}" --nofork -e "$@" ;;
        ghostty)        exec "${terminal:-ghostty}" -e "$@" ;;
        kitty)          exec "${terminal:-kitty}" "$@" ;;
        alacritty)      exec "${terminal:-alacritty}" -e "$@" ;;
        gnome-terminal) exec "${terminal:-gnome-terminal}" -- "$@" ;;
        foot)           exec "${terminal:-foot}" "$@" ;;
        *) die "no supported terminal found; set SYSPILOT_TERMINAL" ;;
    esac
}

copilot() {
    local prompt= caller_pwd="$PWD" recipe="" health=""
    local -a cmd
    printf -v prompt '%s ' "$@"
    prompt=${prompt% }
    [[ -n $prompt ]] || die "--copilot requires a question"

    if [[ -n ${SYSPILOT_COPILOT_CMD:-} ]]; then
        terminal_exec $SYSPILOT_COPILOT_CMD "$@"
        return
    fi

    have goose || die "Goose CLI is not installed"

    # Recipe Resolution:
    # 1. User config override: SYSPILOT_GOOSE_RECIPE
    # 2. Local project packaging: packaging/goose/recipes/copilot-admin.yaml
    # 3. System installed: /usr/share/syspilot/goose/recipes/copilot-admin.yaml
    if [[ -n ${SYSPILOT_GOOSE_RECIPE:-} && -f $SYSPILOT_GOOSE_RECIPE ]]; then
        recipe=$SYSPILOT_GOOSE_RECIPE
    elif [[ -f "$PROJECT_ROOT/packaging/goose/recipes/copilot-admin.yaml" ]]; then
        recipe="$PROJECT_ROOT/packaging/goose/recipes/copilot-admin.yaml"
    elif [[ -f "$DEFAULT_DATA_ROOT/goose/recipes/copilot-admin.yaml" ]]; then
        recipe="$DEFAULT_DATA_ROOT/goose/recipes/copilot-admin.yaml"
    fi

    health=$(compact_health_context || printf '%s' 'cache=unavailable')

    if [[ -n $recipe && -f $recipe ]]; then
        cmd=(env
             GOOSE_MODE=approve
             SECURITY_PROMPT_ENABLED=true
             GOOSE_DISABLE_SESSION_NAMING=true
             GOOSE_CLI_SHOW_COST=true
             goose run --recipe "$recipe"
             --params "user_query=$prompt"
             --params "health_context=$health"
             --params "working_directory=$caller_pwd"
             --interactive --name syspilot-sre --max-turns 15)
    else
        cmd=(env
             GOOSE_DISABLE_SESSION_NAMING=true
             GOOSE_CLI_SHOW_COST=true
             goose run --text
             "Cached health: $health. User request: $prompt"
             --interactive --name syspilot-sre --max-turns 15)
    fi
    terminal_exec "${cmd[@]}"
}

launch_gui() {
    local gui_script=""
    if [[ -f "$PROJECT_ROOT/gui/syspilot_gui.py" ]]; then
        gui_script="$PROJECT_ROOT/gui/syspilot_gui.py"
    elif [[ -f "/usr/lib/syspilot/gui/syspilot_gui.py" ]]; then
        gui_script="/usr/lib/syspilot/gui/syspilot_gui.py"
    fi

    if [[ -n $gui_script && -f $gui_script ]]; then
        # Launch detached single-instance GUI without terminal
        nohup python3 "$gui_script" >/dev/null 2>&1 &
        exit 0
    else
        die "SysPilot GUI component not found"
    fi
}

forward_engine() {
    local engine
    engine=$(resolve_engine)
    exec "$engine" "$@"
}

user_unit() {
    local verb=$1
    have systemctl || die "systemctl is required"
    systemctl --user cat syspilot-tray.service >/dev/null 2>&1 || \
        die "packaged syspilot-tray.service is not installed"
    exec systemctl --user "$verb" --now syspilot-tray.service
}

case ${1:-} in
    -h|--help)          usage ;;
    --gui)              launch_gui ;;
    -s|--status)        print_status ;;
    -j|--json)          print_json ;;
    -a|--audit)         shift; forward_engine --audit "$@" ;;
    -u|--upgrade)       shift; forward_engine --upgrade "$@" ;;
    --software)         shift; forward_engine --software "$@" ;;
    -o|--orphans)       shift; forward_engine --orphans "$@" ;;
    --mirrors)          shift; forward_engine --mirrors "$@" ;;
    -m|--maintenance)   shift; forward_engine --maintenance "$@" ;;
    -d|--deep-clean)    shift; forward_engine --deep-clean "$@" ;;
    -g|--gaming)        shift; forward_engine --gaming "$@" ;;
    --copilot)
        shift
        (($#)) || die "--copilot requires a question"
        copilot "$@"
        ;;
    --copilot-shell)
        copilot "Begin an interactive system SRE session. Do not run diagnostics until asked."
        ;;
    --tray|"")
        if have syspilot-tray; then
            exec syspilot-tray
        elif [[ -f "$PROJECT_ROOT/gui/syspilot_gui.py" ]]; then
            exec python3 "$PROJECT_ROOT/gui/syspilot_gui.py" --tray
        else
            die "SysPilot tray component is not installed"
        fi
        ;;
    --enable-autostart)  user_unit enable ;;
    --disable-autostart) user_unit disable ;;
    *) die "unknown option: $1 (use --help)" ;;
esac
