import { Theme } from "../theme.slint";

export component ActionButton inherits Rectangle {
    in property <string> text: "ACTION";
    in property <bool> primary: false;
    in property <color> action-color: Theme.status-green;
    callback clicked();

    background: touch.pressed ? action-color.darker(30%)
               : touch.has-hover ? (primary ? action-color.darker(15%) : action-color.transparentize(80%))
               : (primary ? action-color : Colors.transparent);
    border-color: primary ? Colors.transparent : action-color;
    border-width: primary ? 0px : 1px;
    border-radius: Theme.radius-sm;
    height: 32px;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;

        Text {
            text: root.text;
            color: root.primary ? #0b0f19 : root.action-color;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
