export component LcarsBottomElbow inherits Path {
    in property <color> fill-color: #ff9900;
    private property <float> w: max(root.width / 1px, 148.0);
    private property <float> h: max(root.height / 1px, 64.0);

    width: 220px;
    fit: ImageFit.preserve;
    fill: root.fill-color;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    MoveTo {
        x: 0;
        y: 0;
    }
    LineTo {
        x: 0;
        y: root.h - 28;
    }
    CubicTo {
        control-1-x: 0;
        control-1-y: root.h - 12.536;
        control-2-x: 12.536;
        control-2-y: root.h;
        x: 28;
        y: root.h;
    }
    LineTo {
        x: root.w;
        y: root.h;
    }
    LineTo {
        x: root.w;
        y: root.h - 44;
    }
    LineTo {
        x: 148;
        y: root.h - 44;
    }
    CubicTo {
        control-1-x: 136.954;
        control-1-y: root.h - 44;
        control-2-x: 128;
        control-2-y: root.h - 52.954;
        x: 128;
        y: root.h - 64;
    }
    LineTo {
        x: 128;
        y: 0;
    }
    Close {
    }
}
