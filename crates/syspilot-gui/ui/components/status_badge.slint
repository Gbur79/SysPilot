import { Theme } from "../theme.slint";

export component StatusBadge inherits Rectangle {
    in property <string> text: "PASS";
    in property <color> badge-color: Theme.status-green;

    background: badge-color.transparentize(85%);
    border-color: badge-color.transparentize(60%);
    border-width: 1px;
    border-radius: Theme.radius-sm;
    horizontal-stretch: 0;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 3px;
        padding-bottom: 3px;

        Text {
            text: root.text;
            color: root.badge-color;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
