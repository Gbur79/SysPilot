export global Theme {
    // Base surfaces
    in property <color> background: #0b0f19;
    in property <color> surface: #131b2e;
    in property <color> surface-hover: #1b2640;
    in property <color> surface-active: #223152;
    in property <color> border-subtle: #1e293b;

    // Typography
    in property <color> text-primary: #f8fafc;
    in property <color> text-secondary: #94a3b8;
    in property <color> text-muted: #64748b;

    // Semantic Telemetry Colors
    in property <color> status-green: #22c55e;
    in property <color> status-amber: #f59e0b;
    in property <color> status-red: #ef4444;
    in property <color> status-cyan: #38bdf8;
    in property <color> status-purple: #a855f7;

    // Radius & Spacing
    in property <length> radius-sm: 4px;
    in property <length> radius-md: 8px;
    in property <length> radius-lg: 12px;
}
