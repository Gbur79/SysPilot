# Maintainer: Karol Gbur
pkgname=syspilot
pkgver=2.1.1
pkgrel=1
pkgdesc="Ultra-lean Native Rust SRE Desktop Cockpit & Health Sentinel for Arch Linux"
arch=('x86_64')
url="https://github.com/Gbur79/SysPilot"
license=('Apache-2.0')
depends=(
    'bash'
    'pacman-contrib'
    'jq'
    'libnotify'
    'fontconfig'
    'freetype2'
    'hicolor-icon-theme'
)
makedepends=(
    'cargo'
)
optdepends=(
    'sys-health: canonical system diagnostics and maintenance engine'
    'arch-audit: for CVE vulnerability telemetry'
    'fwupd: for hardware firmware update checks'
    'goose-cli: for autonomous AI diagnostics'
    'antigravity: for Antigravity SRE copilot sessions'
    'gamemode: for automatic diagnostics inhibition during active gaming sessions'
    'yay: for AUR updates triage'
    'paru: for AUR updates triage'
    'bubblewrap: for sandboxed gaming runners (FAF)'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo build --release --locked -p syspilot-tray -p syspilot-gui
}

package() {
    cd "$srcdir/$pkgname-$pkgver"

    # Install main executables
    install -Dm755 target/release/syspilot-tray "$pkgdir/usr/bin/syspilot-tray"
    install -Dm755 target/release/syspilot-gui "$pkgdir/usr/bin/syspilot-gui"
    install -Dm755 bin/syspilot "$pkgdir/usr/bin/syspilot"
    install -Dm755 bin/syspilot-faf-repair "$pkgdir/usr/bin/syspilot-faf-repair"
    install -Dm755 bin/syspilot-faf-repair "$pkgdir/usr/lib/$pkgname/bin/syspilot-faf-repair"

    # Install desktop entries (GUI launcher for app menu, tray launcher for autostart)
    install -Dm644 packaging/syspilot.desktop "$pkgdir/usr/share/applications/syspilot.desktop"
    install -Dm644 autostart/syspilot.desktop "$pkgdir/etc/xdg/autostart/syspilot.desktop"

    # Install systemd user service
    install -Dm644 systemd/syspilot-tray.service "$pkgdir/usr/lib/systemd/user/syspilot-tray.service"

    # Install copilot playbooks, quirks, and recipes
    install -dm755 "$pkgdir/usr/share/$pkgname"
    if [[ -d copilot ]]; then
        cp -r copilot "$pkgdir/usr/share/$pkgname/"
    fi
    install -Dm644 packaging/goose/recipes/copilot-admin.yaml "$pkgdir/usr/share/$pkgname/goose/recipes/copilot-admin.yaml"
    install -Dm644 packaging/goose/skills/copilot-admin/SKILL.md "$pkgdir/usr/share/$pkgname/goose/skills/copilot-admin/SKILL.md"

    # Install documentation and license
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
