[Unit]
Description=SysPilot system health sentinel
Documentation=https://github.com/Gbur79/SysPilot
After=graphical-session.target
ConditionFileIsExecutable=%h/.local/bin/syspilot-sentinel

[Service]
Type=oneshot
ExecStart=%h/.local/bin/syspilot-sentinel --once
TimeoutStartSec=2min
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
